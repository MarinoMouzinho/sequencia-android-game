<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/mediumgray">

    <TextView
        android:id="@+id/tvWildTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESCOLHA O VALOR"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <GridLayout
        android:id="@+id/gridWildValues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/btnWild1"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="1"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild2"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="2"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild3"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="3"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild4"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="4"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild5"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="5"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild6"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="6"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild7"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="7"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild8"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="8"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild9"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="9"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild10"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="10"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild11"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="11"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

        <Button
            android:id="@+id/btnWild12"
            android:layout_width="75dp"
            android:layout_height="55dp"
            android:text="12"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/fiftydarkgray"/>

    </GridLayout>

    <Button
        android:id="@+id/btnCancelWild"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/cancel_button"
        android:textColor="@color/white"
        android:backgroundTint="@color/mediumred"/>

</LinearLayout>