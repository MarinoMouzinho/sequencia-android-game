<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="@color/mediumgray">

    <TextView
        android:id="@+id/tvRoundEndTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FIM DA RODADA"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvRoundEndMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Rodada terminou!"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/tvRoundEndScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pontuação: 0"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnNextRound"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="PRÓXIMA RODADA"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"/>

    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="NOVO JOGO"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"
        android:visibility="gone"/>

</LinearLayout>